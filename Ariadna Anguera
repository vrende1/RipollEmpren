<!DOCTYPE html>
<html lang="ca">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>La Paradeta · Emprenedoria · Institut Lluís Companys</title>
<meta name="description" content="Productes i serveis dels alumnes d’emprenedoria de l’Institut Lluís Companys, per a tota la comunitat educativa.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Figtree:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #eef3f7;
    --card: #ffffff;
    --ink: #12263a;
    --muted: #4d6073;
    --cobalt: #2446e8;
    --sun: #ffc93c;
    --mint: #1f9f84;
    --line: #cfdbe6;
    --radius: 14px;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "Figtree", system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  h1, h2, h3 { font-family: "Bricolage Grotesque", "Figtree", system-ui, sans-serif; line-height: 1.1; margin: 0; }
  a { color: var(--cobalt); }
  :focus-visible { outline: 3px solid var(--cobalt); outline-offset: 3px; }

  /* Tendal de paradeta: l’element memorable de la pàgina */
  .awning {
    height: 46px;
    background: repeating-linear-gradient(90deg, var(--cobalt) 0 56px, #fff 56px 112px);
    border-bottom: 6px solid var(--ink);
    -webkit-mask: radial-gradient(circle 28px at 28px 100%, transparent 27px, #000 28px) 0 0 / 56px 100% repeat-x;
            mask: radial-gradient(circle 28px at 28px 100%, transparent 27px, #000 28px) 0 0 / 56px 100% repeat-x;
    -webkit-mask: none; mask: none;
  }
  .awning { border-bottom-left-radius: 0; box-shadow: 0 6px 0 var(--ink) inset; }

  header.hero { max-width: 960px; margin: 0 auto; padding: 56px 20px 32px; }
  .school { margin: 0 0 14px; color: var(--muted); font-weight: 600; }
  .hero h1 { font-size: clamp(2.6rem, 8vw, 5rem); font-weight: 800; letter-spacing: -0.02em; }
  .hero p.lead { max-width: 56ch; font-size: 1.2rem; margin: 20px 0 0; }

  main { max-width: 960px; margin: 0 auto; padding: 0 20px 64px; }

  .controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 24px 0 28px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip {
    font: inherit; font-weight: 600; cursor: pointer;
    padding: 9px 18px; border-radius: 999px;
    border: 2px solid var(--ink); background: transparent; color: var(--ink);
  }
  .chip[aria-pressed="true"] { background: var(--ink); color: #fff; }
  .search { flex: 1 1 220px; }
  .search input {
    width: 100%; font: inherit; padding: 10px 16px; border-radius: 999px;
    border: 2px solid var(--line); background: #fff; color: var(--ink);
  }
  .count { color: var(--muted); margin: 0 0 16px; }

  .grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); }
  .item {
    background: var(--card); border: 2px solid var(--ink); border-radius: var(--radius);
    padding: 20px; display: flex; flex-direction: column; gap: 10px;
    box-shadow: 5px 5px 0 var(--ink);
  }
  .tag {
    align-self: flex-start; font-size: .85rem; font-weight: 600;
    padding: 3px 12px; border-radius: 999px; background: var(--sun); color: var(--ink);
  }
  .tag.servei { background: #c9f0e6; }
  .item h3 { font-size: 1.4rem; font-weight: 800; }
  .item p { margin: 0; color: var(--muted); }
  .meta { margin-top: auto; padding-top: 12px; border-top: 2px dashed var(--line); display: grid; gap: 4px; font-size: .97rem; }
  .price { font-family: "Bricolage Grotesque", sans-serif; font-weight: 800; font-size: 1.5rem; }
  .empty { padding: 32px; border: 2px dashed var(--line); border-radius: var(--radius); text-align: center; }

  .join {
    margin-top: 56px; padding: 32px; border-radius: var(--radius);
    background: var(--cobalt); color: #fff;
  }
  .join h2 { font-size: 2rem; font-weight: 800; }
  .join p { max-width: 58ch; margin: 12px 0 0; }
  .join a { color: #fff; font-weight: 600; }

  footer { max-width: 960px; margin: 0 auto; padding: 0 20px 40px; color: var(--muted); font-size: .95rem; }

  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
</head>
<body>

<div class="awning" aria-hidden="true"></div>

<header class="hero">
  <p class="school">Institut Lluís Companys · Alumnes d’emprenedoria</p>
  <h1>La Paradeta</h1>
  <p class="lead">Productes i serveis fets pels alumnes d’emprenedoria per a tota la comunitat de l’institut: alumnes, famílies i professorat. Mira què s’ofereix i contacta amb el grup.</p>
</header>

<main>
  <div class="controls">
    <div class="chips" role="group" aria-label="Filtra per tipus">
      <button class="chip" data-filter="tot" aria-pressed="true">Tot</button>
      <button class="chip" data-filter="producte" aria-pressed="false">Productes</button>
      <button class="chip" data-filter="servei" aria-pressed="false">Serveis</button>
    </div>
    <div class="search">
      <label for="cerca" class="sr" style="position:absolute;left:-9999px">Cerca</label>
      <input id="cerca" type="search" placeholder="Cerca per nom o paraula clau">
    </div>
  </div>

  <p class="count" id="count" aria-live="polite"></p>
  <section class="grid" id="grid" aria-label="Llista de productes i serveis"></section>

  <section class="join" id="participa">
    <h2>Vols formar part de La Paradeta?</h2>
    <p>Si el teu grup d’emprenedoria vol aparèixer en aquesta web, explica-ho al professorat responsable i afegirem la vostra oferta: nom, descripció, preu i com podeu ser contactats.</p>
    <p>Contacte: <a href="mailto:emprenedoria@elteuinstitut.cat">emprenedoria@elteuinstitut.cat</a></p>
  </section>
</main>

<footer>
  <p>Projecte de l’alumnat d’emprenedoria de l’Institut Lluís Companys.</p>
</footer>

<script>
  /* ============================================================
     AQUÍ ES CANVIEN LES OFERTES. Per afegir-ne una, copia un bloc
     { ... }, enganxa’l a la llista i canvia les dades.
     tipus: "producte" o "servei"
     (Són exemples: substitueix-los per les ofertes reals.)
     ============================================================ */
  const OFERTES = [
    {
      nom: "Galetes artesanes",
      tipus: "producte",
      descripcio: "Galetes de mantega i xocolata fetes a mà. Es poden encarregar per a aniversaris i celebracions.",
      preu: "1,50 € / unitat",
      grup: "Grup 1r Batxillerat A",
      on: "Pati, dijous a l’esbarjo"
    },
    {
      nom: "Pulseres personalitzades",
      tipus: "producte",
      descripcio: "Pulseres de fil amb el teu nom o els colors del teu equip preferit.",
      preu: "2 €",
      grup: "Grup 4t ESO B",
      on: "Pati, dimecres a l’esbarjo"
    },
    {
      nom: "Classes de repàs de matemàtiques",
      tipus: "servei",
      descripcio: "Reforç per a alumnes de 1r i 2n d’ESO, amb alumnat de cursos superiors.",
      preu: "3 € / sessió",
      grup: "Grup 1r Batxillerat B",
      on: "Biblioteca, dimarts a la tarda"
    },
    {
      nom: "Fotografia d’esdeveniments",
      tipus: "servei",
      descripcio: "Cobrim festes, graduacions i activitats de l’institut. Rebràs les fotos en un àlbum digital.",
      preu: "Preu a convenir",
      grup: "Grup 2n Batxillerat A",
      on: "Contacta per correu"
    },
    {
      nom: "Cartells i disseny gràfic",
      tipus: "servei",
      descripcio: "Dissenyem cartells, invitacions i logotips per a entitats i activitats de l’institut.",
      preu: "Des de 5 €",
      grup: "Grup 4t ESO A",
      on: "Contacta per correu"
    }
  ];

  const grid = document.getElementById("grid");
  const count = document.getElementById("count");
  const cerca = document.getElementById("cerca");
  const chips = document.querySelectorAll(".chip");
  let filtre = "tot";

  function crea(tag, classe, text) {
    const el = document.createElement(tag);
    if (classe) el.className = classe;
    if (text) el.textContent = text;
    return el;
  }

  function pinta() {
    const q = cerca.value.trim().toLowerCase();
    const llista = OFERTES.filter(o =>
      (filtre === "tot" || o.tipus === filtre) &&
      (o.nom + " " + o.descripcio + " " + o.grup).toLowerCase().includes(q)
    );

    grid.replaceChildren();
    count.textContent = llista.length === 1 ? "1 oferta" : llista.length + " ofertes";

    if (!llista.length) {
      grid.appendChild(crea("p", "empty", "No hem trobat cap oferta. Prova una altra cerca o canvia el filtre."));
      return;
    }

    llista.forEach(o => {
      const card = crea("article", "item");
      card.appendChild(crea("span", "tag " + o.tipus, o.tipus === "servei" ? "Servei" : "Producte"));
      card.appendChild(crea("h3", "", o.nom));
      card.appendChild(crea("p", "", o.descripcio));
      const meta = crea("div", "meta");
      meta.appendChild(crea("span", "price", o.preu));
      meta.appendChild(crea("span", "", o.grup));
      meta.appendChild(crea("span", "", o.on));
      card.appendChild(meta);
      grid.appendChild(card);
    });
  }

  chips.forEach(btn => btn.addEventListener("click", () => {
    filtre = btn.dataset.filter;
    chips.forEach(b => b.setAttribute("aria-pressed", String(b === btn)));
    pinta();
  }));
  cerca.addEventListener("input", pinta);
  pinta();
</script>
</body>
</html>
